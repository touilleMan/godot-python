void init_pythonscript_gdextension() {
    init_functions();  // Must be first (to obtain `string_name_new_with_utf8_chars`)
    init_builtin_destructors();  // Must be second (to obtain `StringName` destructor)
    init_builtin_functions();
    init_variant_converters();
    init_utility_functions();
}
