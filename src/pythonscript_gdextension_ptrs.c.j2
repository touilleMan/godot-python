static void init_builtin_functions() {
    char _gdname[GD_STRING_NAME_MAX_SIZE];
{% for builtin in api.builtins %}
{%   for c in builtin.constructors %}
    pythonscript_gdptr_{{ builtin.snake_name }}_constructor_{{ c.index }} = \
        pythonscript_gdptr_variant_get_ptr_constructor({{ builtin.variant_type_name }}, {{ c.index }});
{%   endfor %}
{%   for m in builtin.methods %}
    pythonscript_gdptr_string_name_new_with_utf8_chars(&_gdname, "{{ m.original_name }}");
    pythonscript_gdptr_{{ builtin.snake_name }}_meth_{{ m.name }} = \
        pythonscript_gdptr_variant_get_ptr_builtin_method({{ builtin.variant_type_name }}, &_gdname, {{ m.hash }});
    pythonscript_gdptr_string_name_destructor(&_gdname);
{%   endfor %}
{%   if builtin.indexing_return_type is not none and builtin.is_keyed %}
    pythonscript_gdptr_{{ builtin.snake_name }}_keyed_setter = \
        pythonscript_gdptr_variant_get_ptr_keyed_setter({{ builtin.variant_type_name }});
    pythonscript_gdptr_{{ builtin.snake_name }}_keyed_getter = \
    pythonscript_gdptr_variant_get_ptr_keyed_getter({{ builtin.variant_type_name }});
{%   endif %}
{%   if builtin.indexing_return_type is not none and not builtin.is_keyed %}
    pythonscript_gdptr_{{ builtin.snake_name }}_indexed_setter = \
        pythonscript_gdptr_variant_get_ptr_indexed_setter({{ builtin.variant_type_name }});
    pythonscript_gdptr_{{ builtin.snake_name }}_indexed_getter = \
        pythonscript_gdptr_variant_get_ptr_indexed_getter({{ builtin.variant_type_name }});
{%   endif %}
{%   for o in builtin.operators %}
{# TODO: make sure GDEXTENSION_VARIANT_TYPE_NIL also represents variant type #}
{%     if o.right_type is none or o.right_type.is_variant %}
    pythonscript_gdptr_{{ builtin.snake_name }}_op_{{ o.name }} = \
        pythonscript_gdptr_variant_get_ptr_operator_evaluator({{ o.variant_operator_name }}, {{ builtin.variant_type_name }}, GDEXTENSION_VARIANT_TYPE_NIL);
{%     else %}
    pythonscript_gdptr_{{ builtin.snake_name }}_op_{{ o.name }} = \
        pythonscript_gdptr_variant_get_ptr_operator_evaluator({{ o.variant_operator_name }}, {{ builtin.variant_type_name }}, {{ o.right_type.variant_type_name }});
{%     endif %}
{%   endfor %}
{%   for m in builtin.members %}
{%     if not m.is_in_struct %}
    pythonscript_gdptr_string_name_new_with_utf8_chars(&_gdname, "{{ m.name }}");
    pythonscript_gdptr_{{ builtin.snake_name }}_get_{{ m.name }} = \
        pythonscript_gdptr_variant_get_ptr_setter({{ builtin.variant_type_name }}, &_gdname);
    pythonscript_gdptr_{{ builtin.snake_name }}_set_{{ m.name }} = \
        pythonscript_gdptr_variant_get_ptr_getter({{ builtin.variant_type_name }}, &_gdname);
    pythonscript_gdptr_string_name_destructor(&_gdname);
{%     endif %}
{%   endfor %}
    pythonscript_gdptr_{{ builtin.snake_name }}_from_variant = \
        pythonscript_gdptr_get_variant_to_type_constructor({{ builtin.variant_type_name }});
    pythonscript_gdptr_{{ builtin.snake_name }}_into_variant = \
        pythonscript_gdptr_get_variant_from_type_constructor({{ builtin.variant_type_name }});
{% endfor %}
}


