#########################################################################
# Render arguments body & signature
#########################################################################


{% macro render_args_signature(args) -%}
{%- for arg in args -%}
{{ arg.type.c_type }}{{ "" if arg.type.is_scalar else "*" }} {{ arg.name }}
{%- if not loop.last %}, {% endif -%}
{%- endfor -%}
{% endmacro %}


{% macro render_args(args) -%}
{%- for arg in args %}
{{ "&" if arg.type.is_scalar else "" }}{{ arg.name }}
{%- if not loop.last %}, {% endif -%}
{%- endfor -%}
{% endmacro %}


#########################################################################
# Utility function
#########################################################################


{% macro render_utility_function_signature(builtin) -%}
{% if builtin.is_vararg %}
{{ "void" if builtin.return_type.is_nil else builtin.return_type.c_type }} gd_utils_{{ builtin.original_name }}(gd_variant_t **args, int args_count)
{%- else %}
{{ "void" if builtin.return_type.is_nil else builtin.return_type.c_type }} gd_utils_{{ builtin.original_name }}(
    {{- render_args_signature(builtin.arguments) -}}
)
{%- endif %}
{%- endmacro %}


{% macro render_utility_function_standard(builtin) %}
cdef inline {{ render_utility_function_signature(builtin) }}:
{% if (builtin.arguments | length) != 0 %}
    cdef gdextension_interface.GDExtensionTypePtr[{{ builtin.arguments | length }}] __args = [
        {{- render_args(builtin.arguments) -}}
    ]
{% endif %}
{% if not builtin.return_type.is_nil %}
    cdef {{ builtin.return_type.c_type }} __ret
{%   if not builtin.return_type.is_stack_only %}
    # TODO: zeroing ret still needed ?
    # ptrcall makes us jump right into C++ code (i.e. Godot internals) that expects constructor to be called on each parameter
    __ret = gd_{{ builtin.return_type.snake_name }}_new()
{%   else %}
    # C compiler doesn't like passing to a function a pointer on uninitialized
    # data (see `-Wmaybe-uninitialized`).
    # Should be optimized out in the end given the called function end up inlined.
    memset(&__ret, 0, sizeof(__ret))
{%   endif %}
{% endif %}
    gdptrs.gdptr_utils_{{ builtin.original_name }}(
{#      gdextension_interface.GDExtensionTypePtr ret #}
        {{ "NULL" if builtin.return_type.is_nil else "&__ret" }},
{#      const gdextension_interface.GDExtensionTypePtr *p_arguments #}
        <const void **>{{ "NULL" if (builtin.arguments | length) == 0 else "__args" }},
{#      int p_argument_count #}
        {{ builtin.arguments | length }}
    )
{% if not builtin.return_type.is_nil %}
    return __ret
{% endif %}
{% endmacro %}


{% macro render_utility_function_vararg(builtin) %}
cdef inline {{ render_utility_function_signature(builtin) }}:
{% if builtin.return_type.is_nil %}
    gdptrs.gdptr_utils_{{ builtin.original_name }}(NULL, <const void **>args, args_count)
{% else %}
{%   if not builtin.return_type.is_nil %}
    cdef {{ builtin.return_type.c_type }} __ret
{%     if not builtin.return_type.is_stack_only %}
    # TODO: zeroing ret still needed ?
    # ptrcall makes us jump right into C++ code (i.e. Godot internals) that expects constructor to be called on each parameter
    __ret = gd_{{ builtin.return_type.snake_name }}_new()
{%     else %}
    # C compiler doesn't like passing to a function a pointer on uninitialized
    # data (see `-Wmaybe-uninitialized`).
    # Should be optimized out in the end given the called function end up inlined.
    memset(&__ret, 0, sizeof(__ret))
{%     endif %}
{%   endif %}
    gdptrs.gdptr_utils_{{ builtin.original_name }}(&__ret, <const void **>args, args_count)
    return __ret
{% endif %}
{% endmacro %}


{% macro render_utility_function(builtin) %}
# {{ builtin.original_name }}
{% if builtin.is_vararg %}
{{ render_utility_function_vararg(builtin) }}
{% else %}
{{ render_utility_function_standard(builtin) }}
{% endif %}
{% endmacro %}


#########################################################################
# Builtin constructors/destructor
#########################################################################


{% macro render_builtin_from_variant_signature(builtin) %}
{{ builtin.c_type }} gd_{{ builtin.snake_name }}_from_variant(const gd_variant_t *val)
{%- endmacro %}


{% macro render_builtin_into_variant_signature(builtin) %}
{%- if builtin.is_scalar %}
gd_variant_t gd_{{ builtin.snake_name }}_into_variant(const {{ builtin.c_type }} val)
{%- else %}
gd_variant_t gd_{{ builtin.snake_name }}_into_variant(const {{ builtin.c_type }} *val)
{%- endif %}
{% endmacro %}


{% macro render_builtin_object_variant_conversions(builtin) %}
cdef inline gdextension_interface.GDExtensionObjectPtr gd_object_from_variant(const gd_variant_t *val):
    cdef gdextension_interface.GDExtensionObjectPtr ret
    gdptrs.gdptr_object_from_variant(&ret, <gd_variant_t *>val)
    return ret


cdef inline gd_variant_t gd_object_into_variant(gdextension_interface.GDExtensionObjectPtr val):
    cdef gd_variant_t ret
    gdptrs.gdptr_object_into_variant(&ret, &val)
    return ret
{% endmacro %}


{% macro render_builtin_variant_conversions(builtin) %}
cdef inline {{ render_builtin_from_variant_signature(builtin) }}:
    cdef {{ builtin.c_type }} ret
    gdptrs.gdptr_{{ builtin.snake_name }}_from_variant(&ret, <gd_variant_t *>val)
    return ret


cdef inline {{ render_builtin_into_variant_signature(builtin) }}:
    cdef gd_variant_t ret
    gdptrs.gdptr_{{ builtin.snake_name }}_into_variant(&ret, <{{ builtin.c_type }} *>{{ "&val" if builtin.is_scalar else "val"}})
    return ret
{% endmacro %}


{% macro render_builtin_constructor_signature(builtin, constructor) -%}
{{ builtin.c_type }} gd_{{ constructor.c_name }}({{ render_args_signature(constructor.arguments) }})
{%- endmacro %}


{% macro render_builtin_constructor(builtin, constructor) %}
cdef inline {{ render_builtin_constructor_signature(builtin, constructor) }}:
    cdef {{ builtin.c_type }} obj
{% if (constructor.arguments | length) != 0 %}
    cdef gdextension_interface.GDExtensionTypePtr[{{ constructor.arguments | length }}] p_args = [
        {{- render_args(constructor.arguments) -}}
    ]
{% endif %}
    gdptrs.gdptr_{{ builtin.snake_name }}_constructor_{{ constructor.index }}(
        &obj,
        <const void **>{{ "NULL" if (constructor.arguments | length) == 0 else "p_args" }}
    )
    return obj
{% endmacro %}


{% macro render_builtin_destructor_signature(builtin) -%}
void gd_{{ builtin.snake_name }}_del({{ builtin.c_type }}* self)
{%- endmacro %}


{% macro render_builtin_destructor(builtin) %}
cdef inline {{ render_builtin_destructor_signature(builtin) }}:
    gdptrs.gdptr_{{ builtin.snake_name }}_destructor(self)
{% endmacro %}


#########################################################################
# Builtin methods
#########################################################################


{% macro render_builtin_method_signature(builtin, meth) -%}
{{ "void" if meth.return_type.is_nil else meth.return_type.c_type }} gd_{{ builtin.snake_name }}_meth_{{ meth.name }}(
    {{- builtin.c_type }} *self
{%- if meth.is_vararg -%}
, gd_variant_t **args, int args_count
{%- else -%}
{%-   if meth.arguments | length %}, {{ render_args_signature(meth.arguments) -}} {% endif -%}
{%- endif -%}
)
{%- endmacro %}


{% macro render_builtin_method_vararg(builtin, meth) %}
cdef inline {{ render_builtin_method_signature(builtin, meth) }}:
    cdef gdextension_interface.GDExtensionTypePtr* __args = <gdextension_interface.GDExtensionTypePtr*>args
{% if not meth.return_type.is_nil %}
    cdef {{ meth.return_type.c_type }} __ret
{%   if not meth.return_type.is_stack_only %}
    # ptrcall makes us jump right into C++ code (i.e. Godot internals) that expects constructor to be called on each parameter
    __ret = gd_{{ meth.return_type.snake_name }}_new()
{%   else %}
    # C compiler doesn't like passing to a function a pointer on uninitialized
    # data (see `-Wmaybe-uninitialized`).
    # Should be optimized out in the end given the called function end up inlined.
    memset(&__ret, 0, sizeof(__ret))
{%   endif %}
{% endif %}
    gdptrs.gdptr_{{ builtin.snake_name }}_meth_{{ meth.name }}(
        {# gdextension_interface.GDExtensionTypePtr p_base #}
        self,
        {# const gdextension_interface.GDExtensionTypePtr *__args #}
        <const void **>__args,
        {# gdextension_interface.GDExtensionTypePtr __ret #}
        {{ "NULL" if meth.return_type.is_nil else "&__ret" }},
        {# int p_argument_count #}
        args_count
    )
{% if not meth.return_type.is_nil %}
    return __ret
{% endif %}
{% endmacro %}


{% macro render_builtin_method_standard(builtin, meth) %}
cdef inline {{ render_builtin_method_signature(builtin, meth) }}:
{% if meth.arguments | length %}
    cdef gdextension_interface.GDExtensionTypePtr[{{ meth.arguments | length }}] __args = [
        {{- render_args(meth.arguments) -}}
    ]
{% else %}
    cdef gdextension_interface.GDExtensionTypePtr* __args = NULL
{% endif %}
{% if not meth.return_type.is_nil %}
    cdef {{ meth.return_type.c_type }} __ret
{%   if not meth.return_type.is_stack_only %}
    # ptrcall makes us jump right into C++ code (i.e. Godot internals) that expects constructor to be called on each parameter
    __ret = gd_{{ meth.return_type.snake_name }}_new()
{%   else %}
    # C compiler doesn't like passing to a function a pointer on uninitialized
    # data (see `-Wmaybe-uninitialized`).
    # Should be optimized out in the end given the called function end up inlined.
    memset(&__ret, 0, sizeof(__ret))
{%   endif %}
{% endif %}
    gdptrs.gdptr_{{ builtin.snake_name }}_meth_{{ meth.name }}(
        {# gdextension_interface.GDExtensionTypePtr p_base #}
        self,
        {# const gdextension_interface.GDExtensionTypePtr *__args #}
        <const void **>__args,
        {# gdextension_interface.GDExtensionTypePtr __ret #}
        {{ "NULL" if meth.return_type.is_nil else "&__ret" }},
        {# int p_argument_count #}
        {{ meth.arguments | length }}
    )
{% if not meth.return_type.is_nil %}
    return __ret
{% endif %}
{% endmacro %}


{% macro render_builtin_method(builtin, meth) %}
{% if meth.is_vararg %}
{{ render_builtin_method_vararg(builtin, meth) }}
{% else %}
{{ render_builtin_method_standard(builtin, meth) }}
{% endif %}
{% endmacro %}


#########################################################################
# Builtin setter/getter
#########################################################################


{% macro render_builtin_member_getter(builtin, m) %}
cdef inline {{ m.type.c_type }} gd_{{ builtin.snake_name }}_get_{{ m.name }}({{ builtin.c_type }} *self):
    cdef {{ m.type.c_type }} __ret
{% if not m.type.is_stack_only %}1
    # ptrcall makes us jump right into C++ code (i.e. Godot internals) that expects constructor to be called on each parameter
    __ret = gd_{{ m.type.snake_name }}_new()
{% else %}
    # C compiler doesn't like passing to a function a pointer on uninitialized
    # data (see `-Wmaybe-uninitialized`).
    # Should be optimized out in the end given the called function end up inlined.
    memset(&__ret, 0, sizeof(__ret))
{% endif %}
    gdptrs.gdptr_{{ builtin.snake_name }}_get_{{ m.name }}(self, &__ret)
    return __ret
{% endmacro %}


{% macro render_builtin_member_setter(builtin, m) %}
cdef inline void gd_{{ builtin.snake_name }}_set_{{ m.name }}(
    {{ builtin.c_type }} *self,
    {{ m.type.c_type }} {{ "" if m.type.is_scalar else "*" }}val
):
    gdptrs.gdptr_{{ builtin.snake_name }}_set_{{ m.name }}(self, {{ "&val" if m.type.is_scalar else "val" }})
{% endmacro %}


#########################################################################
# Builtin indexed setter/getter (e.g. `my_array[42]`)
#########################################################################


{% macro render_builtin_indexed_getter(builtin) %}
cdef inline {{ builtin.indexing_return_type.c_type }} gd_{{ builtin.snake_name }}_indexed_getter(const {{ builtin.c_type }} *self, gdextension_interface.GDExtensionInt index):
    cdef {{ builtin.indexing_return_type.c_type }} __ret
{%   if not builtin.indexing_return_type.is_stack_only %}
    # ptrcall makes us jump right into C++ code (i.e. Godot internals) that expects constructor to be called on each parameter
    __ret = gd_{{ builtin.indexing_return_type.snake_name }}_new()
{%   else %}
    # C compiler doesn't like passing to a function a pointer on uninitialized
    # data (see `-Wmaybe-uninitialized`).
    # Should be optimized out in the end given the called function end up inlined.
    memset(&__ret, 0, sizeof(__ret))
{%   endif %}
    gdptrs.gdptr_{{ builtin.snake_name }}_indexed_getter(self, index, &__ret)
    return __ret
{% endmacro %}


{% macro render_builtin_indexed_setter(builtin) %}
cdef inline void gd_{{ builtin.snake_name }}_indexed_setter(
    {{ builtin.c_type }} *self,
    gdextension_interface.GDExtensionInt index,
    {{ builtin.indexing_return_type.c_type }} {{ "" if builtin.indexing_return_type.is_scalar else "*" }}value
):
    gdptrs.gdptr_{{ builtin.snake_name }}_indexed_setter(self, index, {{ "&" if builtin.indexing_return_type.is_scalar else "" }}value)
{% endmacro %}


#########################################################################
# Builtin keyed setter/getter (e.g. `my_dict['foo']`)
#########################################################################


{% macro render_builtin_keyed_getter(builtin) %}
cdef inline {{ builtin.indexing_return_type.c_type }} gd_{{ builtin.snake_name }}_keyed_getter(const {{ builtin.c_type }} *self, const gd_variant_t *key):
    cdef {{ builtin.indexing_return_type.c_type }} __ret
{%   if not builtin.indexing_return_type.is_stack_only %}
    # ptrcall makes us jump right into C++ code (i.e. Godot internals) that expects constructor to be called on each parameter
    __ret = gd_{{ builtin.indexing_return_type.snake_name }}_new()
{%   else %}
    # C compiler doesn't like passing to a function a pointer on uninitialized
    # data (see `-Wmaybe-uninitialized`).
    # Should be optimized out in the end given the called function end up inlined.
    memset(&__ret, 0, sizeof(__ret))
{%   endif %}
    gdptrs.gdptr_{{ builtin.snake_name }}_keyed_getter(self, key, &__ret)
    return __ret
{% endmacro %}


{% macro render_builtin_keyed_setter(builtin) %}
cdef inline void gd_{{ builtin.snake_name }}_keyed_setter(
    {{ builtin.c_type }} *self,
    const gd_variant_t *key,
    const {{ builtin.indexing_return_type.c_type }} {{ "" if builtin.indexing_return_type.is_scalar else "*" }}value
):
    gdptrs.gdptr_{{ builtin.snake_name }}_keyed_setter(self, key, {{ "&" if builtin.indexing_return_type.is_scalar else "" }}value)
{% endmacro %}


#########################################################################
# Builtin operators
#########################################################################


{% macro render_builtin_operators(builtin) %}
{% for o in builtin.operators %}
{%   if o.right_type is none %}
cdef inline {{ o.return_type.c_type }} gd_{{ builtin.snake_name }}_op_{{ o.name }}(
    const {{ builtin.c_type }} *self
):
    cdef {{ o.return_type.c_type }} result
    gdptrs.gdptr_{{ builtin.snake_name }}_op_{{ o.name }}(self, NULL, &result)
    return result
{%   else %}
cdef inline {{ o.return_type.c_type }} gd_{{ builtin.snake_name }}_op_{{ o.name }}(
    const {{ builtin.c_type }} *self,
    const {{ o.right_type.c_type }} *other
):
    cdef {{ o.return_type.c_type }} result
    gdptrs.gdptr_{{ builtin.snake_name }}_op_{{ o.name }}(self, other, &result)
    return result
{%   endif %}
{% endfor %}
{% endmacro %}


#########################################################################
# All stuff combined
#########################################################################


{% macro render_builtin_methods(builtin) %}
{{ render_builtin_variant_conversions(builtin) }}
{%   for c in builtin.constructors %}
{{ render_builtin_constructor(builtin, c) }}
{%   endfor %}
{%   if not builtin.is_stack_only %}
{{ render_builtin_destructor(builtin) }}
{%   endif %}
{%   for m in builtin.methods %}
{{ render_builtin_method(builtin, m) }}
{%   endfor %}
{%   if builtin.indexing_return_type is not none and builtin.is_keyed %}
{{ render_builtin_keyed_getter(builtin) }}
{{ render_builtin_keyed_setter(builtin) }}
{%   endif %}
{%   if builtin.indexing_return_type is not none and not builtin.is_keyed %}
{{ render_builtin_indexed_getter(builtin) }}
{{ render_builtin_indexed_setter(builtin) }}
{%   endif %}
{{ render_builtin_operators(builtin) }}
{% for m in builtin.members %}
{%   if not m.is_in_struct %}
{{ render_builtin_member_getter(builtin, m) }}
{{ render_builtin_member_setter(builtin, m) }}
{%   endif %}
{% endfor %}
{% endmacro %}
