{% macro render_all_conversions() %}
cdef str _ENSURE_IS_GDANY_ERR_MSG = "Invalid value `{}`, expected IntoGDAny"
cdef str _ENSURE_IS_GDSTRING_ERR_MSG = "Invalid value `{}`, expected str or GDString"
cdef str _ENSURE_IS_STRINGNAME_ERR_MSG = "Invalid value `{}`, expected str or StringName"
cdef str _ENSURE_IS_NODEPATH_ERR_MSG = "Invalid value `{}`, expected be str or NodePath"

cdef bint gd_variant_supports_py_type(object pytype):
    if issubclass(pytype, GDObject):
        return True
    elif (
{% for builtin in api.builtins %}
        pytype == {{ builtin.cy_type }} or
{% endfor %}
        pytype == bool or
        pytype == int or
        pytype == float or
        pytype == type(None)
    ):
        return True
    else:
        return False


cdef object gd_to_py_type(gdextension_interface.GDExtensionVariantType gdtype):
    if gdtype == gdextension_interface.GDEXTENSION_VARIANT_TYPE_OBJECT:
        return GDObject
{% for builtin in api.builtins %}
    elif gdtype == gdextension_interface.{{ builtin.variant_type_name }}:
        return {{ builtin.cy_type }}
{% endfor %}
    elif gdtype == gdextension_interface.{{ api.bool_type.variant_type_name }}:
        return bool
    elif gdtype == gdextension_interface.{{ api.int_type.variant_type_name }}:
        return int
    elif gdtype == gdextension_interface.{{ api.float_type.variant_type_name }}:
        return float
    elif gdtype == gdextension_interface.{{ api.nil_type.variant_type_name }}:
        return None
    else:
        warn(f"No Python equivalent for Godot type `{gdtype}`")
        return None


cdef gdextension_interface.GDExtensionVariantType py_to_gd_type(object pytype):
    if issubclass(pytype, GDObject):
        return gdextension_interface.GDEXTENSION_VARIANT_TYPE_OBJECT
{% for builtin in api.builtins %}
    elif pytype == {{ builtin.cy_type }}:
        return gdextension_interface.{{ builtin.variant_type_name }}
{% endfor %}
    elif pytype == bool:
        return gdextension_interface.{{ api.bool_type.variant_type_name }}
    elif pytype == int:
        return gdextension_interface.{{ api.int_type.variant_type_name }}
    elif pytype == float:
        return gdextension_interface.{{ api.float_type.variant_type_name }}
    elif pytype == type(None):
        return gdextension_interface.{{ api.nil_type.variant_type_name }}
    else:
        warn(f"No Godot equivalent for Python type `{pytype}`")
        return gdextension_interface.GDEXTENSION_VARIANT_TYPE_NIL


#########################################################################
# Gdoot Variant -> PyObject
#########################################################################


cdef object gd_variant_steal_into_pyobj(const gdapi.gd_variant_t *gdvar):
    cdef gdextension_interface.GDExtensionVariantType gdtype = gdptrs.gdptr_variant_get_type(gdvar)
    if gdtype == gdextension_interface.GDEXTENSION_VARIANT_TYPE_OBJECT:
        raise NotImplementedError  # TODO
        # # TODO: This conversion relies on godot String and lookup into bindings
        # # modules, wouldn't it be better to create a `ObjectFromVariant` lazy
        # # class instead ?
        # return Object.cast_from_variant(gdvar)
    elif gdtype == gdextension_interface.{{ api.bool_type.variant_type_name }}:
        return gdapi.gd_{{ api.bool_type.snake_name }}_from_variant(<gdapi.gd_variant_t*>gdvar)
    elif gdtype == gdextension_interface.{{ api.int_type.variant_type_name }}:
        return gdapi.gd_{{ api.int_type.snake_name }}_from_variant(<gdapi.gd_variant_t*>gdvar)
    elif gdtype == gdextension_interface.{{ api.float_type.variant_type_name }}:
        return gdapi.gd_{{ api.float_type.snake_name }}_from_variant(<gdapi.gd_variant_t*>gdvar)
{% for builtin in api.builtins %}
    elif gdtype == gdextension_interface.{{ builtin.variant_type_name }}:
        return _gd_variant_steal_into_pyobj_{{ builtin.cy_type }}(gdvar)
{% endfor %}
    elif gdtype == gdextension_interface.GDEXTENSION_VARIANT_TYPE_NIL:
        return None
    else:
        warn(f"Unknown Godot Variant type `{gdtype}` (this should never happen !)")
        return None


{% for builtin in api.builtins if not builtin.is_nil %}
cdef inline object _gd_variant_steal_into_pyobj_{{ builtin.cy_type }}(const gdapi.gd_variant_t *gdvar):
    cdef {{ builtin.cy_type }} ret = {{ builtin.cy_type }}.__new__({{ builtin.cy_type }})
    ret._gd_data = gdapi.gd_{{ builtin.snake_name }}_from_variant(<gdapi.gd_variant_t *>gdvar)
    gdapi.gd_variant_del(gdvar)
    return ret
{% endfor %}


cdef object gd_variant_copy_into_pyobj(const gdapi.gd_variant_t *gdvar):
    cdef gdapi.gd_variant_t copy
    # TODO: must do an ugly cast because autopxd2 ignores const qualifiers in the C headers
    gdptrs.gdptr_variant_new_copy(&copy, <gdapi.gd_variant_t *>gdvar)
    return gd_variant_steal_into_pyobj(&copy)


#########################################################################
# PyObject -> Godot Variant
#########################################################################


# TODO rename given stealing is not possible with GDExtension C++ orientated API
cdef bint gd_variant_steal_from_pyobj(object pyobj, gdapi.gd_variant_t *gdvar):
    if pyobj is None:
        gdptrs.gdptr_variant_new_nil(gdvar)
    elif isinstance(pyobj, GDObject):
        gdvar[0] = gdapi.gd_object_into_variant((<GDObject>pyobj)._gd_ptr)
    elif isinstance(pyobj, bool):  # TODO: try/except on the gdapi.gd_bool_into_variant is enough ?
        gdvar[0] = gdapi.gd_bool_into_variant(pyobj)
    elif isinstance(pyobj, int):
        gdvar[0] = gdapi.gd_int_into_variant(pyobj)
    elif isinstance(pyobj, float):
        gdvar[0] = gdapi.gd_float_into_variant(pyobj)
    elif isinstance(pyobj, str):
        _gd_variant_steal_from_pyobj_pystr(pyobj, gdvar)
{% for builtin in api.builtins if not builtin.is_scalar %}
    elif isinstance(pyobj, {{ builtin.cy_type }}):
        gdvar[0] = gdapi.gd_{{ builtin.snake_name }}_into_variant(&(<{{ builtin.cy_type }}>pyobj)._gd_data)
{% endfor %}
    else:
        return False
    return True


cdef inline void _gd_variant_steal_from_pyobj_pystr(object pyobj, gdapi.gd_variant_t *gdvar):
    cdef gdapi.gd_string_t gdstr = gdapi.gd_string_from_unchecked_pystr(pyobj)
    gdvar[0] = gdapi.gd_string_into_variant(&gdstr)
    gdapi.gd_string_del(&gdstr)
    # into conversion steals the ownership, so don't need to call `gdapi.gd_string_del(gdstr)`
{% endmacro %}
