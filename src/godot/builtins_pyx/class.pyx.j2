{% from 'builtins_pyx/constructor.pyx.j2' import render_constructors with context %}
{% from 'builtins_pyx/member.pyx.j2' import render_member with context %}
{% from 'builtins_pyx/method.pyx.j2' import render_method with context %}
{% from 'builtins_pyx/operator.pyx.j2' import render_operators with context %}


{% macro render_constant(builtin, c) %}
{%   if c.type.is_scalar %}
{{ c.name }} = {{ c.value }}
{%   else %}
@staticmethod
def {{ c.name }}():
    cdef gd_variant_t gdvariant
    cdef gd_string_name_t gdname = gdapi.gd_string_name_from_utf8_and_len(b"{{ c.original_name }}", {{ c.original_name | length }})
    gdptrs.gdptr_variant_get_constant_value(gdextension_interface.{{ builtin.variant_type_name }}, &gdname, &gdvariant)
    gdapi.gd_string_name_del(&gdname)
    return gd_variant_steal_into_pyobj(&gdvariant)
    # No need to destroy gdvariant given the conversion has stolen ownership on data !
{%   endif %}
{% endmacro %}


{% macro render_class(builtin) %}
{% for e in builtin.enums %}
class {{ builtin.cy_type }}{{ e.original_name }}(IntEnum):
{%   for item in e.items %}
    {{ item.py_name }} = {{ item.value }}
{%   endfor %}


{% endfor %}
@cython.freelist(8)
@cython.final
cdef class {{ builtin.cy_type }}:
    # Constructors
    {{ render_constructors(builtin) | indent }}

{% if not builtin.is_stack_only %}
    # Destructor
    def __dealloc__({{ builtin.cy_type }} self):
        # /!\ if `__cinit__` is skipped, `_gd_data` must be initialized by
        # hand otherwise we will get a segfault here
        gdapi.gd_{{ builtin.snake_name }}_del(&self._gd_data)
{% endif %}

    # Operators
    {{ render_operators(builtin) | indent }}

{% if builtin.constants %}
    # Constants

{% endif %}
{% for c in builtin.constants %}
    {{ render_constant(builtin, c) | indent }}
{% endfor %}

{% if builtin.members %}
    # Members

{% endif %}
{% for m in builtin.members %}
    {{ render_member(builtin, m) | indent }}
{% endfor %}

{% if builtin.methods %}
    # Methods

{% endif %}
{% for m in builtin.methods %}
    {{ render_method(builtin, m) | indent }}
{% endfor %}

{% if builtin.enums %}
    # Enums

{% endif %}
{% for e in builtin.enums %}
    {{ e.original_name }} = {{ builtin.cy_type }}{{ e.original_name }}
{% endfor %}

{# TODO: Cython currently doesn't support cpdef with @staticmethod #}
{# see: https://github.com/cython/cython/issues/3327 #}
{% for m in builtin.methods %}
{% if m.is_static %}
    @staticmethod
    def {{ m.name }}({%- for arg in m.arguments -%}{{ arg.name }}, {%- endfor -%}):
        return {{ builtin.cy_type }}._{{ m.name }}({%- for arg in m.arguments -%}{{ arg.name }}, {%- endfor -%})
{% endif %}
{% endfor %}

{% endmacro %}
