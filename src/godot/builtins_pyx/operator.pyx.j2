{% macro render_operator_with_right_hand(builtin, operator_py_name, operator_gdapi_name, operators, convert_result_to_bool)%}
def {{ operator_py_name }} (self, object other):
{% if operators | length == 1 %}
{{ render_operator_with_right_hand_body_single_dispatch(builtin, operator_gdapi_name, operators[0], convert_result_to_bool) }}
{% else %}
{{ render_operator_with_right_hand_body_multiple_dispatch(builtin, operator_gdapi_name, operators, convert_result_to_bool) }}
{% endif %}
{% endmacro %}

{% macro render_operator_with_right_hand_body_single_dispatch(builtin, operator_gdapi_name, op, convert_result_to_bool) %}
{% if op.right_type.is_scalar is not none %}
    cdef {{ op.right_type.c_type }} converted_scalar
{% endif %}
    cdef {{ op.right_type.c_type }} *other_gd_data
{% if not op.return_type.is_scalar %}
    # Check `other`'s type before creating `ret` (since, once created, its
    # destructor must be run!)
    cdef {{ op.return_type.cy_type }} ret
{% endif %}

    try:
{% if op.right_type.is_scalar %}
        converted_scalar = <{{ op.right_type.c_type }}?>other
        other_gd_data = &converted_scalar
{% else %}
        other_gd_data = &(<{{ op.right_type.cy_type }}?>other)._gd_data
{% endif %}
    except TypeError:
        return NotImplemented

{% if op.return_type.is_scalar %}
{%   if convert_result_to_bool %}
    return gdapi.gd_{{ builtin.snake_name }}_op_{{ operator_gdapi_name }}_{{ op.right_type.snake_name }}(&self._gd_data, other_gd_data) != 0
{%   else %}
    return gdapi.gd_{{ builtin.snake_name }}_op_{{ operator_gdapi_name }}_{{ op.right_type.snake_name }}(&self._gd_data, other_gd_data)
{%   endif %}
{% else %}
    # Call to __new__ bypasses __init__ constructor
    ret = {{ op.return_type.cy_type }}.__new__({{ op.return_type.cy_type }})
    ret._gd_data =  gdapi.gd_{{ builtin.snake_name }}_op_{{ operator_gdapi_name }}_{{ op.right_type.snake_name }}(&self._gd_data, other_gd_data)
    return ret
{% endif %}
{% endmacro %}

{% macro render_operator_with_right_hand_body_multiple_dispatch(builtin, operator_gdapi_name, operators, convert_result_to_bool) %}
{% set max_scalar_size = operators | map(attribute="right_type") | selectattr("is_scalar") | map(attribute="size") | max | default(None) %}
{% if max_scalar_size is not none %}
    cdef char converted_scalar_buffer[{{ max_scalar_size }}]
{% endif %}
    cdef void *other_gd_data
{% set non_scalar_return_cy_types = operators | map(attribute="return_type") | rejectattr("is_scalar") | map(attribute="cy_type") | unique | list %}
{% if non_scalar_return_cy_types | length > 0 %}
    # Check `other`'s type before creating `ret` (since, once created, its
    # destructor must be run!)
{% endif %}
{% for non_scalar_return_cy_type in non_scalar_return_cy_types %}
    cdef {{ non_scalar_return_cy_type }} ret_{{ non_scalar_return_cy_type }}
{% endfor %}

    cdef object other_type = type(other)
{% for op in operators %}
    if other_type is {{ op.right_type.py_type }}:
{%   if op.right_type.is_scalar %}
        (<{{ op.right_type.c_type }}*>&converted_scalar_buffer)[0] = <{{ op.right_type.c_type }}>other
        other_gd_data = &converted_scalar_buffer
{%   else %}
        other_gd_data = &(<{{ op.right_type.cy_type }}>other)._gd_data
{%   endif %}
{%   if op.return_type.is_scalar %}
{%   if convert_result_to_bool %}
        return gdapi.gd_{{ builtin.snake_name }}_op_{{ operator_gdapi_name }}_{{ op.right_type.snake_name }}(&self._gd_data, other_gd_data) != 0
{%   else %}
        return gdapi.gd_{{ builtin.snake_name }}_op_{{ operator_gdapi_name }}_{{ op.right_type.snake_name }}(&self._gd_data, other_gd_data)
{%   endif %}
{%   else %}
        # Call to __new__ bypasses __init__ constructor
        ret_{{ op.return_type.cy_type }} = {{ op.return_type.cy_type }}.__new__({{ op.return_type.cy_type }})
        ret_{{ op.return_type.cy_type }}._gd_data =  gdapi.gd_{{ builtin.snake_name }}_op_{{ operator_gdapi_name }}_{{ op.right_type.snake_name }}(&self._gd_data, <{{ op.right_type.c_type }} *>other_gd_data)
        return ret_{{ op.return_type.cy_type }}
{%   endif %}
{% endfor%}

    return NotImplemented
    {# raise TypeError(f"unsupported operand type(s) for +: '{type(self)}' and '{type(other)}'") #}
{% endmacro %}

{% macro render_operators(builtin) -%}
{# Operators are few and full of quirks, so we implement them by hand #}

{% if builtin.original_name in ("String", "StringName", "NodePath") %}
def __str__(self):
    return self.to_pystr()
{% endif %}

def __repr__(self):
{%   if builtin.is_transparent_builtin %}
    return f"{{ builtin.cy_type }}(
{%-   for subm in builtin.c_struct_members -%}
{%-     if subm.type.is_scalar -%}
    {{ subm.name }}={ self.{{ subm.name }} }
{%-     else -%}
    {{ subm.name }}={ {{ subm.type.cy_type }}.from_gd_data(self._gd_data.{{ subm.name }}) }
{%-     endif -%}
{%- if not loop.last %}, {% endif -%}
{%-   endfor %})"
{%   elif builtin.original_name in ("String", "StringName", "NodePath") %}
    return f"{{ builtin.cy_type}}({self.to_pystr()!r})"
{%   else %}
{%     if builtin.is_stack_only %}
    cdef gd_variant_t gdvar = gdapi.gd_{{ builtin.snake_name }}_to_variant(&self._gd_data)
{%     else %}
    cdef gd_variant_t gdvar = gdapi.gd_{{ builtin.snake_name }}_copy_into_variant(&self._gd_data)
{%     endif %}
    cdef gd_string_t gdstr
    gdptrs.gdptr_variant_stringify(&gdvar, &gdstr)
{%     if not builtin.is_stack_only %}
    # No need to call `gdapi.gd_variant_del(&gdvar)` since this builtin is stack only (i.e. variant del is a noop)
{%     else %}
    gdapi.gd_variant_del(&gdvar)
{%     endif %}
    try:
        return f"{{ builtin.cy_type}}({gdapi.gd_string_to_pystr(&gdstr)})"
    finally:
        gdapi.gd_string_del(&gdstr)
{%   endif %}

{# Note `Color` has a `hash` method, but it excluded since it is not an immutable type #}
{% if builtin.original_name in ("String", "StringName", "NodePath", "Callable") %}
def __hash__(self):
    cdef int64_t ret = gdapi.gd_{{ builtin.snake_name }}_meth_hash(
        &self._gd_data,
    )
    return ret
{% endif %}

def __eq__(self, object other):
    cdef {{ builtin.c_type }}* other_gd_data
    try:
        other_gd_data = &(<{{ builtin.cy_type }}?>other)._gd_data
    except TypeError:
        return False
{% if builtin.is_transparent_builtin %}
    return (
{%   for field_path in  builtin.all_nested_scalar_members %}
        {% if not loop.first %}and {% endif %}self._gd_data.{{ field_path }} == other_gd_data.{{ field_path }}
{%   endfor %}
    )
{% else %}
    return gdapi.gd_{{ builtin.snake_name }}_op_equal_{{ builtin.snake_name }}(&self._gd_data, other_gd_data)
{% endif %}

{% if builtin.original_name in ("Dictionary", "Array") or builtin.is_packed_array %}
{# Note `__bool__` is not needed if `__len__` is defined #}
def __len__(self):
    cdef int64_t size = gdapi.gd_{{ builtin.snake_name }}_meth_size(&self._gd_data)
    return size
{% elif builtin.original_name in ("String", "StringName") %}
{# Note `__bool__` is not needed if `__len__` is defined #}
def __len__(self):
    cdef int64_t length = gdapi.gd_{{ builtin.snake_name }}_meth_length(&self._gd_data)
    return length
{% elif builtin.is_transparent_builtin %}
def __bool__(self):
    return (
{%   for field_path in builtin.all_nested_scalar_members %}
        {% if not loop.first %}or {% endif %}self._gd_data.{{ field_path }} != 0
{%   endfor %}
    )
{% elif builtin.original_name == "NodePath" %}
def __bool__(self):
    cdef int64_t is_empty = gdapi.gd_{{ builtin.snake_name }}_meth_is_empty(&self._gd_data)
    return not is_empty
{% elif builtin.original_name == "RID" %}
def __bool__(self):
    cdef {{ builtin.c_type }} zero
    memset(&zero, 0, cython.sizeof({{ builtin.c_type }}))
    return not gdapi.gd_{{ builtin.snake_name }}_op_equal_{{ builtin.snake_name }}(&self._gd_data, &zero)
{% else %}
def __bool__(self):
    cdef uint8_t is_null = gdapi.gd_{{ builtin.snake_name }}_meth_is_null(&self._gd_data)
    return not is_null
{% endif %}

{% if builtin.original_name == "Array" or builtin.is_packed_array %}
def __iter__(self):
    for i in range(self.size()):
        yield self.get(i)
{% elif builtin.original_name == "Dictionary" %}
def __iter__(self):
    # TODO: Using `Dictionary.values()` means we use an intermediary array,
    #       we should find a better way...
    yield from self.values()
{% endif %}

{% if builtin.original_name in ("Array", "Dictionary") %}
def __contains__(self, object needle):
    return self.has(needle)
{% elif builtin.is_packed_array %}
{%  if builtin.original_name in ("PackedByteArray", "PackedInt32Array", "PackedInt64Array", "PackedFloat32Array", "PackedFloat64Array") %}
# TODO: `extension_api.json` doesn't expose `in` operator for those types...
def __contains__(self, {{ builtin.indexing_return_type.cy_type }} needle):
    return gdapi.gd_{{ builtin.snake_name }}_meth_has(&self._gd_data, needle) == 1
{%  else %}
def __contains__(self, {{ builtin.indexing_return_type.cy_type }} needle):
    return gdapi.gd_{{ builtin.indexing_return_type.snake_name }}_op_in_{{ builtin.snake_name }}(&needle._gd_data, &self._gd_data) == 1
{%  endif %}
{% elif builtin.original_name in ("String", "StringName") %}
def __contains__(self, object needle):
    return self.contains(needle)
{% endif %}

{% set operators_less = builtin.get_operators("<") %}
{% if operators_less %}
{{ render_operator_with_right_hand(builtin, "__lt__", "less", operators_less, convert_result_to_bool=True) }}
{% endif %}

{% set operators_less_equal = builtin.get_operators("<=") %}
{% if operators_less_equal %}
{{ render_operator_with_right_hand(builtin, "__le__", "less_equal", operators_less, convert_result_to_bool=True) }}
{% endif %}

{% set operators_greater = builtin.get_operators(">") %}
{% if operators_greater %}
{{ render_operator_with_right_hand(builtin, "__gt__", "greater", operators_less, convert_result_to_bool=True) }}
{% endif %}

{% set operators_greater_equal = builtin.get_operators(">=") %}
{% if operators_greater_equal %}
{{ render_operator_with_right_hand(builtin, "__ge__", "greater_equal", operators_less, convert_result_to_bool=True) }}
{% endif %}

{% set operators_add = builtin.get_operators("+") %}
{% if operators_add %}
{{ render_operator_with_right_hand(builtin, "__add__", "add", operators_add) }}
{% endif %}

{% set operators_subtract = builtin.get_operators("-") %}
{% if operators_subtract %}
{{ render_operator_with_right_hand(builtin, "__sub__", "subtract", operators_subtract) }}
{% endif %}

{% set operators_multiply = builtin.get_operators("*") %}
{% if operators_multiply %}
{{ render_operator_with_right_hand(builtin, "__mul__", "multiply", operators_multiply) }}
{% endif %}

{% set operators_divide = builtin.get_operators("/") %}
{% if operators_divide %}
{{ render_operator_with_right_hand(builtin, "__truediv__", "divide", operators_divide) }}
{% endif %}

{% set operators_module = builtin.get_operators("%") %}
{% if builtin.original_name in ("String", "StringName") %}
{# String is a special case since `other` can be of any type... so better just use a variant! #}
def __mod__(self, object other):
    # TODO: Godot currently returns `gdapi.gd_string_op_module_nil` when requesting `gdapi.gd_string_op_module_variant`
    # (see: https://github.com/godotengine/godot/issues/109861)
    cdef gd_variant_t gdany = ensure_is_gdany_and_borrow_ref(other)
    # Call to __new__ bypasses __init__ constructor
    cdef GDString ret = GDString.__new__(GDString)
    ret._gd_data = gdapi.gd_{{ builtin.snake_name }}_op_module_variant(&self._gd_data, &gdany)
    return ret
{% elif operators_module %}
{{ render_operator_with_right_hand(builtin, "__mod__", "module", operators_module) }}
{% endif %}

{% set operators_power = builtin.get_operators("**") %}
{% if operators_power %}
{{ render_operator_with_right_hand(builtin, "__pow__", "power", operators_power) }}
{% endif %}

{% set operators_negate = builtin.get_operators("unary-") %}
{% if operators_negate %}
{% set op = operators_negate[0] %}
def __neg__(self):
    # Call to __new__ bypasses __init__ constructor
    cdef {{ op.return_type.cy_type }} ret = {{ op.return_type.cy_type }}.__new__({{ op.return_type.cy_type }})
    ret._gd_data = gdapi.gd_{{ builtin.snake_name }}_op_negate(&self._gd_data)
    return ret
{% endif %}

{% set operators_positive = builtin.get_operators("unary+") %}
{% if operators_positive %}
{% set op = operators_negate[0] %}
def __pos__(self):
    # Call to __new__ bypasses __init__ constructor
    cdef {{ op.return_type.cy_type }} ret = {{ op.return_type.cy_type }}.__new__({{ op.return_type.cy_type }})
    ret._gd_data = gdapi.gd_{{ builtin.snake_name }}_op_positive(&self._gd_data)
    return ret
{% endif %}

{% if builtin.indexing_return_type and not builtin.is_keyed %}
# TODO: handle out of range error ?

def __getitem__(self, gd_int_t index):
    return self._getitem(index)

def __setitem__(self, gd_int_t index, object value):
    self._setitem(index, value)
{% elif builtin.indexing_return_type and builtin.is_keyed %}
# TODO: handle out of range error ?

def __getitem__(self, object key):
    return self._getitem(key)

def __setitem__(self, object key, object value):
    self._setitem(key, value)
{% endif %}

{% endmacro %}
