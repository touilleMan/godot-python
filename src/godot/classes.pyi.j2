from collections.abc import Mapping, Sequence
from enum import Enum

from .builtins import *

{%- macro render_arg(arg) -%}
{{ "{}: ".format(arg.name) }}
{%- if arg.type.py_type == "GDString" %}
GDString | str
{%- elif arg.type.py_type == "StringName" %}
StringName | str
{%- elif arg.type.py_type == "NodePath" %}
NodePath | str
{%- elif arg.type.py_type == "GDList" %}
GDList | Sequence[IntoGDAny]
{%- elif arg.type.py_type == "GDDictionary" %}
GDDictionary | Mapping[IntoGDAny, IntoGDAny]
{%- else %}
{{ arg.type.py_type }}
{%- endif %}
{%- if arg.default_value is not none %}
 = {{ arg.default_value.py_value }}
{%- endif %}
{%- endmacro %}

{%- macro render_ret(ret) -%}
{{ "None" if ret.is_nil else ret.py_type }}
{%- endmacro %}

{% for klass in api.classes %}


class {{ klass.cy_type }}{{ "(" + klass.inherits.cy_type + ")" if klass.inherits else "" }}:
{%   if klass.description %}
    """{{ klass.description | gd_description_to_py_doc }}"""
{%   endif %}
{%   set ns = namespace(contains_something=false) %}
{%   if klass.is_instantiable %}
{%     set ns.contains_something = True %}
{%     if klass.is_refcounted %}
    def __init__(self): ...
{%     else %}
    @classmethod
    def new(cls) -> {{ klass.py_type }}: ...
{%     endif %}
{%   endif %}
{%   for e in klass.enums %}
{%     if loop.first %}
{%       set ns.contains_something = True %}

    # Enums
{%     endif %}
    class {{ e.original_name }}(Enum):
{%     for item in e.items %}
        {{ item.py_name }}: int
{%       if item.description %}
        """{{ item.description | gd_description_to_py_doc }}"""
{%       endif %}
{%     endfor %}
{%   endfor %}
{%   for m in klass.methods if not m.name.startswith("_") %}
{%     if loop.first %}
{%       set ns.contains_something = True %}

    # Methods
{%     endif %}
    def {{ m.name }}(self{% for a in m.arguments %}, {{ render_arg(a) }}{% endfor %}) -> {{ render_ret(m.return_type) }}:
{%     if m.description %}
        """{{ m.description | gd_description_to_py_doc }}"""
{%     endif %}
        ...
{%   endfor %}
{%   for s in klass.signals %}
{%     if loop.first %}
{%       set ns.contains_something = True %}

    # Signals
{%     endif %}
    def {{ s.name }}(self{% for a in s.arguments %}, {{ render_arg(a) }}{% endfor %}) -> None:
{%     if s.description %}
        """{{ s.description | gd_description_to_py_doc }}"""
{%     endif %}
        ...
{%   endfor %}
{%   for p in klass.properties %}
{%     if loop.first %}
{%       set ns.contains_something = True %}

    # Properties
{%     endif %}
    {{ p.name }}: {{ p.type.py_type }}
{%     if p.description %}
    """{{ p.description | gd_description_to_py_doc }}"""
{%     endif %}
{%   endfor %}
{%   for c in klass.constants %}
{%     if loop.first %}
{%       set ns.contains_something = True %}

    # Constants
{%     endif %}
    {{ c.name }}: int
{%     if c.description %}
    """{{ c.description | gd_description_to_py_doc }}"""
{%     endif %}
{%   endfor %}
{%   if not ns.contains_something %}
    pass
{%   endif %}
{% endfor %}
